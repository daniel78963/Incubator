<UserControl x:Class="Incubator.Desktop.Views.SignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sección Superior: Configuración de Puerto -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <StackPanel Margin="0,0,20,0">
                <ui:TextBlock Text="Puerto COM Disponible:" Margin="0,0,0,5" FontTypography="BodyStrong" />
                <ComboBox ItemsSource="{Binding AvailablePorts}" 
                          SelectedItem="{Binding SelectedPort}" 
                          Width="160" Height="32" />
            </StackPanel>

            <ui:Button Content="Conectar a Dispositivo" 
                       Command="{Binding ConnectCommand}" 
                       Icon="{ui:SymbolIcon PlugConnected24}"
                       Appearance="Primary"
                       VerticalAlignment="Bottom"
                       Margin="0,0,20,0"/>

            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                <ui:TextBlock Text="Estado:" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:TextBlock Text="{Binding ConnectionStatus}" FontTypography="BodyStrong" />
            </StackPanel>
        </StackPanel>

        <!-- Sección Inferior: Histórico de Tramas Decodificadas -->
        <ui:DataGrid Grid.Row="1" 
                     ItemsSource="{Binding FrameHistory}" 
                     AutoGenerateColumns="False" 
                     IsReadOnly="True" 
                     HeadersVisibility="Column"
                     GridLinesVisibility="Horizontal"
                     AlternatingRowBackground="#0AFFFFFF">
            <ui:DataGrid.Columns>
                <!-- Datos decodificados según codificacion_trama.pdf -->
                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" />
                <DataGridTextColumn Header="Pos." Binding="{Binding Position}" />

                <!-- Formateamos la fecha y hora directamente en el XAML -->
                <DataGridTextColumn Header="Inicio Incubación" Binding="{Binding InitialTime, StringFormat=\{0:dd/MM/yy HH:mm\}}" />
                <DataGridTextColumn Header="Fin Incubación" Binding="{Binding FinalTime, StringFormat=\{0:dd/MM/yy HH:mm\}}" />

                <DataGridTextColumn Header="Código QR" Binding="{Binding QrData}" MaxWidth="180" />

                <!-- Trama original que llegó por el puerto -->
                <DataGridTextColumn Header="Trama Cruda (Raw)" Binding="{Binding RawFrame}" Width="*" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </Grid>
</UserControl>