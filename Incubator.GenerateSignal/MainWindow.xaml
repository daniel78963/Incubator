<Window x:Class="Incubator.GenerateSignal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulador de Dispositivo - Incubator" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Simulador de Señales COM" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Configuración de Conexión -->
        <GroupBox Grid.Row="1" Header="Configuración de Puertos (Simulación Concurrente)" Padding="10" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Canal 1 (COM):" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbPort1" Width="120" Margin="0,0,10,0"/>
                    <!-- Simulamos que este dispositivo tiene este serial -->
                    <TextBlock Text="Serial Simulado: 9999" Foreground="Gray" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Baud Rate:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbBaudRate1" Width="120" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Canal 2 (USB):" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbPort2" Width="120" Margin="0,0,10,0"/>
                    <!-- Diferente serial para distinguirlo en la vista final -->
                    <TextBlock Text="Serial Simulado: 5555" Foreground="Gray" VerticalAlignment="Center"/>

                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Baud Rate:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbBaudRate2" Width="120" />
                </StackPanel>

                <Button x:Name="BtnConnect" Content="Conectar Ambos" Width="120" Height="25" 
                HorizontalAlignment="Left" Click="BtnConnect_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Sección de Envío de Trama -->
        <GroupBox Grid.Row="2" Header="Generador de Trama (A1A...)" Padding="10">
            <StackPanel>
                <TextBlock Text="Trama a enviar:" Margin="0,0,0,5"/>
                <!-- TextBox para que puedas modificar la trama antes de enviarla -->
                <TextBox x:Name="TxtFrame" Height="25" VerticalContentAlignment="Center" Padding="5,0"
                         Text="A1A4622130827032300139999----" FontFamily="Consolas"/>

                <TextBlock Text="* El terminador \r\n se agregará automáticamente al enviar." 
                           FontSize="11" Foreground="Gray" Margin="0,5,0,15"/>

                <!--<Button x:Name="BtnSendFrame" Content="Enviar Señal" Width="120" Height="30" 
                        HorizontalAlignment="Right" Click="BtnSendFrame_Click" IsEnabled="False"/>-->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSendBoth" Content="Enviar a Ambos Canales (Test Concurrencia)" 
            Width="250" Height="30" Margin="0,0,10,0" Click="BtnSendBoth_Click" IsEnabled="False"/>
                    <Button x:Name="BtnSendFrame" Content="Enviar Señal (Solo 1)" 
            Width="120" Height="30" Click="BtnSendFrame_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Estado -->
        <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="Desconectado" 
                   VerticalAlignment="Bottom" Foreground="Gray" FontWeight="SemiBold"/>
    </Grid>
</Window>